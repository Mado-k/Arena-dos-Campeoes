# Copie para .env e preencha apenas no seu ambiente. Nunca versione .env.
SENHA_ADMIN=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=arena_campeoes
# Aiven: DB_SSL=true. Se exigido, DB_SSL_CA é o caminho do certificado CA.
DB_SSL=false
# DB_SSL_CA=/caminho/ca.pem
# Porta HTTP do Node, independente da porta MySQL do Aiven.
PORT=16171
